{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "blockish/navmenu-submenu",
  "version": "1.0.0",
  "title": "Nav Menu Submenu",
  "category": "blockish-framework",
  "description": "Dropdown submenu panel for a Nav Menu Item.",
  "keywords": [
    "nav",
    "menu",
    "submenu",
    "dropdown"
  ],
  "parent": [
    "blockish/navmenu-item"
  ],
  "allowedBlocks": [
    "blockish/navmenu-item"
  ],
  "attributes": {
    "itemGap": {
      "type": "object",
      "selectors": {
        ".{{WRAPPER}}, .{{WRAPPER}} .blockish-navmenu-submenu__list": "gap: {{VALUE}};"
      }
    },
    "alignment": {
      "type": "object",
      "selectors": {
        ".{{WRAPPER}} .blockish-navmenu-item-link": "justify-content: {{VALUE}};"
      }
    }
  },
  "supports": {
    "html": false,
    "anchor": false,
    "reusable": false
  },
  "textdomain": "blockish",
  "editorScript": "file:./index.js",
  "editorStyle": "file:./index.css",
  "style": "file:./style-index.css",
  "render": "file:./render.php",
  "usesContext": [
    "postId",
    "postType"
  ]
}
